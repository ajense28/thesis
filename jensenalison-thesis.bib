@article{matthewsMechanisticMultiscaleUncertainty2026,
  title = {Mechanistic {{Multiscale Uncertainty Propagation}} in {{Support}} of {{Accelerated Fuel Qualification}}},
  author = {Matthews, Christopher and Cooper, Michael W. D. and Robbe, Pieterjan and Casey, Tiernan and Sargsyan, Khachik and Najm, Habib N. and Pastore, Giovanni and Blondel, Sophie and Militello, Nick and Wirth, Brian and Levinsky, Alex and White, Joshua and Gibson, Tammie and Stanek, Christopher R. and Andersson, David A.},
