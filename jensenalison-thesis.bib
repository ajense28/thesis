  author = {Miller, Zachary and Johnson, Landon and Alzate-Vargas, Lorena and Rizk, Jason and Matthews, Christopher and Cooper, Michael W. D. and Mehta, Vedant and Andersson, David A. and Craven, Galen T. and Fratoni, Massimiliano and Levinsky, Alex},
  date = {2026-02-26},
  journaltitle = {Nuclear Science and Engineering},
