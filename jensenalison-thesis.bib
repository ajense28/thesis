@article{sakibInsituIonIrradiation2025,
  title = {In-Situ {{Ion Irradiation}} of a {{Spent UO2 Fuel}}: {{Evolution}} of {{Fission Products}} and {{Nanograins}} with {{Radiation Dose}}},
  shorttitle = {In-Situ {{Ion Irradiation}} of a {{Spent UO2 Fuel}}},
  author = {Sakib, Sadman and Lu, Yunyuan and Howard, Cameron B and Burns, Jatuporn and Chen, Wei-Ying and Malakkal, Linu and Jiang, Chao and Biswas, Sudipta and Cappia, Fabiola and He, Lingfeng},
  date = {2025-07-01},
  journaltitle = {Microscopy and Microanalysis},
  shortjournal = {Microsc. Microanal.},
  volume = {31},
  pages = {ozaf048.548},
  issn = {1431-9276},
  doi = {10.1093/mam/ozaf048.548},
  url = {https://doi.org/10.1093/mam/ozaf048.548},
  urldate = {2026-08-04},
  abstract = {Improving the effectiveness and safety of nuclear reactors requires a thorough grasp of how nuclear fuels behave under radiation. Uranium dioxide (UO2) is the primary fuel of commercial light water reactors. It faces major microstructural changes within its matrix because of the generation of fission products during nuclear fission. Noble gases that make up 15\% of fission products, such as krypton (Kr) and xenon (Xe), are poorly soluble in UO2 [1]. They consequently create tiny bubbles that clump together, resulting in decreased thermal conductivity, mechanical deterioration, and fuel swelling [2]. Furthermore, fuel behavior under irradiation is further complicated by metallic precipitates known as five metal precipitates (5MPs), which are mainly made up of 4d group metals like molybdenum (Mo), technetium (Tc), ruthenium (Ru), rhodium (Rh), and palladium (Pd). 5MPs may segregate in the matrix and grain boundaries, contributing to fuel swelling. On the other hand, these precipitates may improve fuel efficiency by boosting heat conduction. Although fission gas bubbles and 5MPs play a crucial role in the behavior of nuclear fuel, little is known about how they develop and interact with the atomic-level microstructure and part of this study aims to address this.},
  issue = {Supplement\_1},
  keywords = {Experimental,Irradiation,Pd,STEM image,UO2,Xe},
  file = {C\:\\Users\\ajense28\\Zotero\\storage\\93WMRBG5\\Sakib et al. - 2025 - In-situ Ion Irradiation of a Spent UO2 Fuel Evolution of Fission Products and Nanograins with Radia.pdf;C\:\\Users\\ajense28\\Zotero\\storage\\CHZTUNUB\\ozaf048.html}
}

