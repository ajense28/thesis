  keywords = {density functional theory,DFT,Theory,VASP,Vienna ab initio Software Package},
  file = {C\:\\Users\\ajense28\\Zotero\\storage\\GJ7GUTAH\\Kresse and Furthmüller - 1996 - Efficiency of ab-initio total energy calculations for metals and semiconductors using a plane-wave b.pdf;C\:\\Users\\ajense28\\Zotero\\storage\\SAQ2XMVR\\0927025696000080.html}
