@article{chenUnifiedEffectDispersed2020,
  title = {Unified {{Effect}} of {{Dispersed Xe}} on the {{Thermal Conductivity}} of {{UO2 Predicted}} by {{Three Interatomic Potentials}}},
  author = {Chen, Weiming and Bai, Xian-Ming},
  date = {2020-04-01},
  journaltitle = {JOM},
  volume = {72},
  number = {4},
  pages = {1710--1718},
  issn = {1543-1851},
  doi = {10.1007/s11837-019-03985-9},
  url = {https://doi.org/10.1007/s11837-019-03985-9},
  urldate = {2026-03-31},
  abstract = {Thermal conductivity is a critical fuel performance property of uranium dioxide (UO2)-based nuclear fuels. Numerous studies have shown that xenon (Xe) fission gas plays a major role in fuel thermal conductivity degradation. It has also been shown that dispersed Xe atoms can cause a stronger phonon-scattering effect than their clustered form. In this work, molecular dynamics simulations are conducted to study the dispersed Xe-induced thermal conductivity reduction using three different interatomic potentials. It is found that although these potentials result in significant discrepancies in the absolute thermal conductivity values, the normalized values are very similar at a wide range of temperatures and Xe concentrations. By integrating this unified effect into the experimentally measured thermal conductivities, a new analytical model is developed to predict the realistic thermal conductivities of UO2 at different dispersed Xe concentrations and temperatures. Using this new model, the critical Xe concentration that offsets the grain boundary Kapitza resistance effect in a high burnup structure is revisited.},
  langid = {english},
  keywords = {computational,fuel with fp,numbers,thermal conductivity},
  file = {C:\Users\ajense28\Zotero\storage\K9K3XWBU\Chen and Bai - 2020 - Unified Effect of Dispersed Xe on the Thermal Conductivity of UO2 Predicted by Three Interatomic Pot.pdf}
}

@article{choiAcceleratedFuelQualification2026,
  title = {Accelerated {{Fuel Qualification}} of {{Fast Modular Reactor Fuel}} in a {{Thermal Reactor}}: {{Modeling}} and {{Simulation Paired}} with {{Irradiation Testing}}},
  shorttitle = {Accelerated {{Fuel Qualification}} of {{Fast Modular Reactor Fuel}} in a {{Thermal Reactor}}},
  author = {Choi, Hangbok and Rizk, Jason and Oswald, Sarah and Borowski, Lucas and Unangst, Jaclynn and Opperman, Jonas and Deck, Christian and Khalifa, Hesham and Faibish, Ron and Miao, Yinbin and Lee, Soon Kyu and Yacout, Abdellatif M. and Back, Christina A.},
  date = {2026-01-02},
  journaltitle = {Nuclear Technology},
  shortjournal = {Nucl. Technol.},
  volume = {212},
  number = {1},
  pages = {50--65},
  publisher = {Taylor \& Francis},
  issn = {0029-5450},
  doi = {10.1080/00295450.2025.2502283},
  url = {https://doi.org/10.1080/00295450.2025.2502283},
  urldate = {2026-03-07},
  abstract = {The accelerated fuel qualification (AFQ) methodology is applied by simulating accelerated fuel tests of the General Atomics Electromagnetic Systems’ fuel system for its 44-MW(electric) gas-cooled, fast-spectrum fast modular reactor (FMR). This fuel is comprised of UO2 pellets in SiGA® cladding, a silicon carbide ceramic matrix composite. Fast reactors, like the FMR, offer many benefits, including high fuel utilization and flexibility, but may require a lengthy material design process if tests are performed using fast neutron irradiation alone. A thermal neutron irradiation can instead be used to rapidly test how well key components of the current material models extend to high burnup. Thermal neutrons produce a different radial power distribution within the pin than fast neutrons. However, the temperature and burnup values for the two neutron types are comparable, and the differences between the simulated fuel responses are relatively small, demonstrating the weak sensitivity of the physics-based fuel model calculations on the neutron type and the irradiation rate. Furthermore, the deformation of the SiGA cladding saturates after about 1 displacement per atom for both neutron spectra. In an accelerated fuel test, the irradiation time required to reach the target fuel burnup can be reduced by a factor of 3 by using a small rodlet with a 45\% smaller pellet diameter while maintaining the same linear power. Therefore, the time for data collection up to high burnup can be significantly reduced while maintaining the same temperature profile, which largely determines the material response. Tests of fuel rodlets of standard and compact size will be carried out in the Idaho National Laboratory’s Advanced Test Reactor (ATR), including full size and compact rodlets with varying gap sizes. By applying physics-based mechanistic modeling and simulation in accordance with the AFQ methodology, this type of compact rodlet testing in a thermal test reactor captures the necessary phenomena to test fuel material models up to high burnup and to simulate the expected impact of fast neutron radiation on the fuel in FMR operations. This approach to testing fast reactor fuels in existing thermal test reactors, paired with advanced physics-based mechanistic modeling and simulation, is expected to be applicable to a range of advanced fuels and will decrease the overall fuel qualification timeframe from decades to years.},
  keywords = {Advanced test reactor (ATR),AFQ,compact rodlet,gas-cooled fast reactor (GFR),high burnup,industry application,multiscale,multiscale modeling,silicon carbide (SiC)},
  file = {C:\Users\ajense28\Zotero\storage\Z2MS7ILQ\Choi et al. - 2026 - Accelerated Fuel Qualification of Fast Modular Reactor Fuel in a Thermal Reactor Modeling and Simul.pdf}
}

@article{cococcioniLinearResponseApproach2005,
  title = {Linear Response Approach to the Calculation of the Effective Interaction Parameters in the \$\textbackslash mathrm\{{{LDA}}\}+\textbackslash mathrm\{{{U}}\}\$ Method},
  author = {Cococcioni, Matteo and family=Gironcoli, given=Stefano, prefix=de, useprefix=true},
  date = {2005-01-18},
  journaltitle = {Physical Review B},
